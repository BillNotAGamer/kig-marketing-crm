# Private authorized development PostgreSQL connection string. Never production for Phase 1.
DATABASE_URL=
# Strong private secret, at least 32 characters.
BETTER_AUTH_SECRET=
# Actual application origin for this environment.
BETTER_AUTH_URL=
# Set to development only after verifying the DB target; gates DB commands/tests.
KIG_DATABASE_ENV=
# Google Drive service account integration. Safe blank placeholders; never commit private keys.
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_DRIVE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Optional: restrict file attachments to a specific Shared Drive ID.
GOOGLE_DRIVE_SHARED_DRIVE_ID=
# Optional private operator inputs for the explicit development bootstrap command.
# Never put real bootstrap credentials in this example or Git.
KIG_BOOTSTRAP_HEAD_NAME=
KIG_BOOTSTRAP_HEAD_EMAIL=
KIG_BOOTSTRAP_HEAD_PASSWORD=
